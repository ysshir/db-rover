{
  "name": "db-rover",
  "displayName": "DB Rover",
  "description": "サイドバーからデータベースを探索し、SQL を実行して結果を確認できる VS Code 拡張機能",
  "version": "0.2.0",
  "publisher": "leptosystem",
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbRover.addConnection",
        "title": "接続を追加",
        "category": "DB Rover",
        "icon": "$(add)"
      },
      {
        "command": "dbRover.editConnection",
        "title": "接続を編集",
        "category": "DB Rover",
        "icon": "$(edit)"
      },
      {
        "command": "dbRover.removeConnection",
        "title": "接続を削除",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.connect",
        "title": "接続",
        "category": "DB Rover",
        "icon": "$(plug)"
      },
      {
        "command": "dbRover.disconnect",
        "title": "切断",
        "category": "DB Rover",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbRover.filterTree",
        "title": "テーブル名で絞り込み",
        "category": "DB Rover",
        "icon": "$(filter)"
      },
      {
        "command": "dbRover.clearTreeFilter",
        "title": "絞り込みを解除",
        "category": "DB Rover",
        "icon": "$(filter-filled)"
      },
      {
        "command": "dbRover.refresh",
        "title": "再読み込み",
        "category": "DB Rover",
        "icon": "$(refresh)"
      },
      {
        "command": "dbRover.newQuery",
        "title": "SQL エディタを開く",
        "category": "DB Rover",
        "icon": "$(terminal)"
      },
      {
        "command": "dbRover.runQuery",
        "title": "クエリを実行（カーソル位置の SQL）",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.previewTableData",
        "title": "データをプレビュー",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.openTable",
        "title": "テーブルを開く",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.copyName",
        "title": "名前をコピー",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.selectActiveConnection",
        "title": "アクティブ接続を選択",
        "category": "DB Rover",
        "icon": "$(database)"
      },
      {
        "command": "dbRover.saveTableEdits",
        "title": "テーブルの変更を保存",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.reloadTableView",
        "title": "テーブルビューを再読み込み",
        "category": "DB Rover",
        "icon": "$(refresh)"
      },
      {
        "command": "dbRover.runStatement",
        "title": "この SQL を実行",
        "category": "DB Rover",
        "icon": "$(play)"
      },
      {
        "command": "dbRover.focusOrRunStatement",
        "title": "DB Rover: カーソル位置の文をハイライト／実行",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.runFocusedStatement",
        "title": "DB Rover: ハイライト中の文を実行",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.clearStatementFocus",
        "title": "DB Rover: 文のハイライトを解除",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.runStatementsFrom",
        "title": "ここから下の SQL をすべて実行",
        "category": "DB Rover",
        "icon": "$(run-below)"
      },
      {
        "command": "dbRover.runAllStatements",
        "title": "すべての SQL を実行",
        "category": "DB Rover",
        "icon": "$(run-all)"
      },
      {
        "command": "dbRover.selectDocumentConnection",
        "title": "このエディタの接続先を選択",
        "category": "DB Rover",
        "icon": "$(database)"
      },
      {
        "command": "dbRover.openWalkthrough",
        "title": "はじめに（使い方）",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.startServer",
        "title": "AI 連携: MCP サーバを開始",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.stopServer",
        "title": "AI 連携: MCP サーバを停止",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.copyMcpConfig",
        "title": "AI 連携: MCP の設定をコピー",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.writeMcpJson",
        "title": "AI 連携: .mcp.json に登録",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.showStatus",
        "title": "AI 連携: 状態を表示",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.rotateToken",
        "title": "AI 連携: トークンを再発行",
        "category": "DB Rover"
      },
      {
        "command": "dbRover.ai.resetApprovals",
        "title": "AI 連携: 書き込みの許可をリセット",
        "category": "DB Rover"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "db-rover",
          "title": "DB Rover",
          "icon": "media/db-rover.svg"
        }
      ],
      "panel": [
        {
          "id": "db-rover-panel",
          "title": "DB Rover",
          "icon": "media/db-rover.svg"
        }
      ]
    },
    "views": {
      "db-rover": [
        {
          "id": "dbRover.connections",
          "name": "接続"
        }
      ],
      "db-rover-panel": [
        {
          "id": "dbRover.queryResult",
          "name": "クエリ結果",
          "type": "webview",
          "contextualTitle": "DB Rover: クエリ結果"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dbRover.refresh",
          "when": "view == dbRover.connections",
          "group": "navigation"
        },
        {
          "command": "dbRover.addConnection",
          "when": "view == dbRover.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbRover.newQuery",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\./",
          "group": "inline@0"
        },
        {
          "command": "dbRover.connect",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\.disconnected/",
          "group": "inline@1"
        },
        {
          "command": "dbRover.disconnect",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\.connected/",
          "group": "inline@1"
        },
        {
          "command": "dbRover.filterTree",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\.(connected|disconnected)$/",
          "group": "inline@2"
        },
        {
          "command": "dbRover.clearTreeFilter",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\..*\\.filtered$/",
          "group": "inline@2"
        },
        {
          "command": "dbRover.previewTableData",
          "when": "view == dbRover.connections && (viewItem == table || viewItem == view)",
          "group": "inline"
        },
        {
          "command": "dbRover.copyName",
          "when": "view == dbRover.connections && (viewItem =~ /^connection\\./ || viewItem == schema || viewItem == table || viewItem == view || viewItem == column || viewItem == index)",
          "group": "1_copy"
        },
        {
          "command": "dbRover.filterTree",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\./",
          "group": "1_filter@1"
        },
        {
          "command": "dbRover.clearTreeFilter",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\..*\\.filtered$/",
          "group": "1_filter@2"
        },
        {
          "command": "dbRover.editConnection",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\./",
          "group": "2_modify@1"
        },
        {
          "command": "dbRover.removeConnection",
          "when": "view == dbRover.connections && viewItem =~ /^connection\\./",
          "group": "2_modify@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbRover.runQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.runStatement",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.focusOrRunStatement",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.runFocusedStatement",
          "when": "false"
        },
        {
          "command": "dbRover.clearStatementFocus",
          "when": "false"
        },
        {
          "command": "dbRover.runStatementsFrom",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.runAllStatements",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.selectDocumentConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbRover.selectActiveConnection"
        },
        {
          "command": "dbRover.openWalkthrough"
        },
        {
          "command": "dbRover.ai.startServer",
          "when": "!dbRover.ai.serverRunning"
        },
        {
          "command": "dbRover.ai.stopServer",
          "when": "dbRover.ai.serverRunning"
        },
        {
          "command": "dbRover.ai.copyMcpConfig"
        },
        {
          "command": "dbRover.ai.writeMcpJson"
        },
        {
          "command": "dbRover.ai.showStatus"
        },
        {
          "command": "dbRover.ai.rotateToken"
        },
        {
          "command": "dbRover.ai.resetApprovals"
        }
      ],
      "editor/title": [
        {
          "command": "dbRover.runStatement",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dbRover.runAllStatements",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbRover.selectDocumentConnection",
          "when": "editorLangId == sql",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "dbRover.runStatement",
          "when": "editorLangId == sql",
          "group": "dbRover@1"
        },
        {
          "command": "dbRover.runStatementsFrom",
          "when": "editorLangId == sql",
          "group": "dbRover@2"
        },
        {
          "command": "dbRover.runAllStatements",
          "when": "editorLangId == sql",
          "group": "dbRover@3"
        },
        {
          "command": "dbRover.selectDocumentConnection",
          "when": "editorLangId == sql",
          "group": "dbRover@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbRover.focusOrRunStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId == sql"
      },
      {
        "command": "dbRover.runFocusedStatement",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == sql && dbRover.statementFocused && !suggestWidgetVisible && !inlineSuggestionVisible && !renameInputVisible && !parameterHintsVisible && !inSnippetMode && !editorHasMultipleSelections"
      },
      {
        "command": "dbRover.clearStatementFocus",
        "key": "escape",
        "when": "editorTextFocus && editorLangId == sql && dbRover.statementFocused"
      },
      {
        "command": "dbRover.runAllStatements",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == sql"
      },
      {
        "command": "dbRover.saveTableEdits",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == dbRover.tableView"
      },
      {
        "command": "dbRover.reloadTableView",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == dbRover.tableView"
      },
      {
        "command": "dbRover.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "focusedView == dbRover.connections"
      }
    ],
    "configuration": {
      "title": "DB Rover",
      "properties": {
        "dbRover.connections": {
          "type": "array",
          "default": [],
          "description": "DB Rover の接続定義の一覧。パスワードは SecretStorage に保存され、ここには書きません。",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "接続の一意な識別子。省略すると name から自動生成されます。"
              },
              "name": {
                "type": "string",
                "description": "接続の表示名"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "postgres",
                  "mysql",
                  "sqlite"
                ],
                "description": "データベースの種類"
              },
              "host": {
                "type": "string",
                "description": "ホスト名（postgres / mysql）"
              },
              "port": {
                "type": "number",
                "description": "ポート番号（postgres / mysql）"
              },
              "database": {
                "type": "string",
                "description": "データベース名（postgres / mysql）"
              },
              "user": {
                "type": "string",
                "description": "ユーザー名（postgres / mysql）"
              },
              "ssl": {
                "type": "boolean",
                "description": "SSL 接続を使用するか（postgres / mysql）"
              },
              "file": {
                "type": "string",
                "description": "SQLite ファイルのパス（ワークスペース相対・絶対・~ 展開に対応）"
              }
            },
            "required": [
              "name",
              "kind"
            ]
          }
        },
        "dbRover.queryRowLimit": {
          "type": "number",
          "default": 500,
          "description": "結果グリッドに表示する最大行数"
        },
        "dbRover.autoConnectOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "起動時にすべての接続を自動的に接続するか"
        },
        "dbRover.pageSize": {
          "type": "number",
          "default": 200,
          "description": "テーブルビューの 1 ページあたりの行数"
        },
        "dbRover.countRows": {
          "type": "boolean",
          "default": true,
          "description": "テーブルビューで総行数（COUNT）を取得するか。大きなテーブルで遅い場合は無効にしてください。"
        },
        "dbRover.exportFormat": {
          "type": "string",
          "enum": [
            "csv",
            "tsv"
          ],
          "enumDescriptions": [
            "カンマ区切り（.csv）",
            "タブ区切り（.tsv）。表計算ソフトへ貼り付けるときはこちらが崩れにくい"
          ],
          "default": "csv",
          "description": "クエリ結果の「コピー」「保存」で書き出す形式。"
        },
        "dbRover.keybindings": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "markdownDescription": "グリッド内のキー割り当てを上書きします。値は `\"ctrl+n\"` のような文字列か、その配列です。修飾子は `ctrl` / `shift` / `alt` / `cmd`、`mod` は macOS で `cmd`・それ以外で `ctrl` になります。書かなかったアクションは既定のままです。保存（既定 `Cmd/Ctrl+S`）は VS Code のキーボードショートカット設定（`dbRover.saveTableEdits`）で変更してください。",
          "properties": {
            "edit": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "選択セルを編集モードにする（既定: enter / f2）"
            },
            "moveUp": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 つ上のセルへ移動（既定: arrowup / ctrl+p）"
            },
            "moveDown": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 つ下のセルへ移動（既定: arrowdown / ctrl+n）"
            },
            "moveLeft": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 つ左のセルへ移動（既定: arrowleft / ctrl+b）"
            },
            "moveRight": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 つ右のセルへ移動（既定: arrowright / ctrl+f）"
            },
            "moveRowStart": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "行の一番左の列へ移動（既定: home / ctrl+a）"
            },
            "moveRowEnd": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "行の一番右の列へ移動（既定: end / ctrl+e）"
            },
            "moveTop": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "先頭行へ移動（既定: ctrl+home / mod+arrowup）"
            },
            "moveBottom": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "末尾行へ移動（既定: ctrl+end / mod+arrowdown）"
            },
            "pageUp": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 画面ぶん上へ移動（既定: pageup）"
            },
            "pageDown": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "1 画面ぶん下へ移動（既定: pagedown）"
            },
            "copy": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "選択セルの値をコピー（既定: mod+c）"
            },
            "setNull": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "選択セルを NULL に設定（既定: alt+n）"
            },
            "deleteRow": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              },
              "description": "選択行の削除候補を切り替え（既定: ctrl+d / delete / backspace）"
            }
          }
        },
        "dbRover.showStatementCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "SQL エディタで、文ごとに実行用の CodeLens（▷ 実行）を表示するか"
        },
        "dbRover.stopOnError": {
          "type": "boolean",
          "default": true,
          "description": "複数の SQL を続けて実行しているときにエラーが起きたら、以降の SQL を実行せず中断するか"
        },
        "dbRover.ai.mcpServer.enabled": {
          "type": "boolean",
          "default": false,
          "description": "AI 連携: ローカルの MCP サーバ（Claude Code など外部 AI 向け）を起動するか。ループバックのみで待ち受けます。"
        },
        "dbRover.ai.languageModelTools.enabled": {
          "type": "boolean",
          "default": true,
          "description": "AI 連携: Copilot Chat などの Language Model Tools として 4 つのツールを公開するか。"
        },
        "dbRover.ai.port": {
          "type": "number",
          "default": 47600,
          "description": "AI 連携: MCP サーバの待ち受けポート。使用中なら自動で 1 つずつ空きを探し、全滅時は空きポートへ切り替えます。0 を指定すると常に空きポートを使います。"
        },
        "dbRover.ai.writes": {
          "type": "string",
          "enum": [
            "ask",
            "never",
            "session"
          ],
          "enumDescriptions": [
            "書き込みを含む文はそのつど確認する",
            "書き込みを含む文はすべて拒否する",
            "接続ごとに一度許可すれば、そのウィンドウを閉じるまで再確認しない（取り消せない文は除く）"
          ],
          "default": "ask",
          "description": "AI 連携: 読み取り以外の SQL 文を実行してよいかどうかの既定動作。取り消せない文（DROP / TRUNCATE / WHERE 無しの DELETE・UPDATE 等）は常に確認します。"
        },
        "dbRover.ai.maxRows": {
          "type": "number",
          "default": 200,
          "description": "AI 連携: dbrover_run_sql が返す既定の最大行数（上限 1000）。呼び出し側の maxRows 指定で個別に上書きできます。"
        },
        "dbRover.ai.maxStatements": {
          "type": "number",
          "default": 10,
          "description": "AI 連携: dbrover_run_sql で一度に実行できる SQL 文の最大数。"
        },
        "dbRover.ai.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "AI 連携: SQL 実行のタイムアウト（ミリ秒）。超過すると該当の接続を切断します。"
        },
        "dbRover.ai.showResults": {
          "type": "boolean",
          "default": true,
          "description": "AI 連携: dbrover_run_sql の実行結果を既存のクエリ結果パネルにも表示するか。"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "dbrover_list_connections",
        "displayName": "DB Rover: 接続一覧",
        "userDescription": "DB Rover で現在接続中のデータベース接続を一覧します。",
