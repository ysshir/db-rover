  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-mutations.mjs && node scripts/check-statements.mjs && node scripts/check-connection-comment.mjs && node scripts/check-recovery.mjs && node scripts/check-resilient.mjs && node scripts/check-export.mjs && node scripts/check-statement-kind.mjs && node scripts/check-ai-limits.mjs && node scripts/check-ai-auth.mjs && node scripts/check-approval.mjs && node scripts/check-mcp-rpc.mjs && node scripts/check-tree-filter.mjs",
    "verify": "npm run typecheck && npm run check",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "install:local": "npm run package && code --install-extension db-rover-$npm_package_version.vsix --force",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "node-sqlite3-wasm": "^0.8.60",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.11.10",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
